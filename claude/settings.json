{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-busy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-pretool-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-idle.sh"
          },
          {
            "type": "command",
            "command": "uv run ~/.dotfiles/scripts/sync_claude_to_obsidian.py 2>/dev/null || true",
            "async": true,
            "statusMessage": "Syncing session to Obsidian..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-idle.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/tmux/claude-statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "skipAutoPermissionPrompt": true,
  "model": "sonnet"
}
