{
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-busy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-pretool-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-waiting.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/scripts/herdr-continuity-sync.sh title-hook --provider claude 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-idle.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.dotfiles/scripts/herdr-continuity-sync.sh push-current 2>/dev/null || true",
            "statusMessage": "Indexing conversation history...",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/tmux/claude-on-idle.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/tmux/claude-statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "skipAutoPermissionPrompt": true,
  "model": "sonnet"
}
