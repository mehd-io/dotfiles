<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.mehd.herdr-continuity-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.dotfiles/scripts/herdr-continuity-sync.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/share/herdr-continuity/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/share/herdr-continuity/launchd-error.log</string>
</dict>
</plist>
