# Copy to ~/.config/dotfiles/env.tpl, then replace OP_VAULT and OP_ITEM with
# local 1Password identifiers. Never commit the personalized copy.

# Values intentionally available to interactive shells.
export motherduck_token="{{ op://OP_VAULT/OP_ITEM/motherduck-token }}"
export GEMINI_API_KEY="{{ op://OP_VAULT/OP_ITEM/gemini-api-key }}"
export DOTFILES_REPO_ROOTS="{{ op://OP_VAULT/OP_ITEM/repo-roots }}"
export OBSIDIAN_VAULT="{{ op://OP_VAULT/OP_ITEM/obsidian-vault }}"

# Machine metadata used only while rendering local configuration.
DOTFILES_REMOTE_HOST="{{ op://OP_VAULT/OP_ITEM/remote-host }}"
DOTFILES_REMOTE_USER="{{ op://OP_VAULT/OP_ITEM/remote-user }}"
DOTFILES_REMOTE_IDENTITY_FILE="{{ op://OP_VAULT/OP_ITEM/remote-identity-file }}"
DOTFILES_REMOTE_REPO_ROOT="{{ op://OP_VAULT/OP_ITEM/remote-repo-root }}"

# Continuity secrets and scheduling remain unexported to normal child processes.
HERDR_CONTINUITY_DATABASE_URL="{{ op://OP_VAULT/OP_ITEM/continuity-database-url }}"
HERDR_CONTINUITY_KEY="{{ op://OP_VAULT/OP_ITEM/continuity-encryption-key }}"
HERDR_CONTINUITY_AUTO_SYNC="{{ op://OP_VAULT/OP_ITEM/continuity-auto-sync }}"
HERDR_CONTINUITY_SYNC_START_HOUR="{{ op://OP_VAULT/OP_ITEM/continuity-sync-start-hour }}"
HERDR_CONTINUITY_SYNC_END_HOUR="{{ op://OP_VAULT/OP_ITEM/continuity-sync-end-hour }}"
