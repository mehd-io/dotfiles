# Run with: brew bundle --file=~/.dotfiles/Brewfile

# === CLI core ===
brew "neovim"                        # modern vim, paired with LazyVim config
brew "tmux"                          # terminal multiplexer
brew "tree"                          # ascii directory listing
brew "wget"                          # http download
brew "curl"                          # http client (newer than system curl)
brew "zsh"                           # shell (default on macOS but brew version is newer)
brew "bash"                          # newer bash (system bash is stuck on 3.2)
brew "starship"                      # prompt (Pastel Powerline preset)
brew "atuin"                         # shell history sync across machines
brew "gh"                            # GitHub CLI
brew "jq"                            # JSON processor
brew "fd"                            # fast find replacement
brew "ripgrep"                       # fast grep replacement (rg)
brew "fzf"                           # fuzzy finder
brew "zoxide"                        # smart cd, jumps to recently used dirs (z, zi)
brew "yazi"                          # terminal file manager
brew "dua-cli"                       # interactive disk usage analyzer (dua i)
brew "ffmpeg"                        # video/audio conversion
brew "imagemagick"                   # image conversion (convert, magick)
brew "poppler"                       # PDF utilities (pdftotext etc), needed by yazi
brew "resvg"                         # SVG renderer, needed by yazi for previews
brew "sevenzip"                      # 7z archiver
brew "aria2"                         # parallel downloader
brew "rclone"                        # rsync for cloud storage (S3, GDrive, etc)
brew "yt-dlp"                        # YouTube downloader
brew "mkvtoolnix"                    # MKV video manipulation (mkvmerge etc)
brew "oven-sh/bun/bun"               # JavaScript runtime + bundler + package manager

# === Data tooling ===
brew "duckdb"                        # in-process analytics db
brew "libpq"                         # postgres client libs (psql)
brew "neonctl"                       # Neon (postgres) CLI
brew "libavif"                       # AVIF image codec

# === Cloud ===
brew "awscli"                        # AWS CLI
cask "gcloud-cli"                    # Google Cloud CLI

# === Status bar / window mgmt ===
brew "felixkratz/formulae/sketchybar"  # custom macOS status bar
cask "nikitabobko/tap/aerospace"     # i3-style tiling window manager
cask "hiddenbar"                     # hide menu bar icons you do not want visible
cask "stats"                         # CPU/RAM/network in menu bar

# === Terminal + dev tools ===
cask "ghostty"                       # native fast terminal
cask "orbstack"                      # Docker + Linux VMs (replaces Docker Desktop)
cask "1password-cli"                 # op CLI, used by zprofile to inject secrets
cask "ngrok"                         # local tunnel

# === Fonts ===
cask "font-hack-nerd-font"           # Hack with nerd-font glyphs (terminal)
cask "font-symbols-only-nerd-font"   # only the nerd-font icons, used by yazi
cask "sf-symbols"                    # Apple symbol library, used by Sketchybar

# === Apps ===
cask "1password"                     # password manager
cask "raycast"                       # Spotlight replacement
cask "obsidian"                      # knowledge base / notes
cask "notion"                        # docs / wiki
cask "slack"                         # chat
cask "spotify"                       # music
cask "whatsapp"                      # chat
cask "obs"                           # screen recording / streaming
cask "tailscale"                     # VPN mesh
cask "figma"                         # design
cask "claude"                        # Claude Desktop app
cask "cursor"                        # AI code editor
cask "brave-browser"                 # browser (privacy)
cask "google-chrome"                 # browser
cask "firefox"                       # browser
cask "ollama"                        # local LLM runner
cask "keka"                          # archive utility (rar, 7z, etc)

# === Optional: large or infrequent. Uncomment what you need. ===
# cask "vlc"                         # media player (~100MB)
# cask "libreoffice"                 # office suite (~600MB, slow download)
# cask "displaylink"                 # DisplayLink dock driver
# cask "nordvpn"                     # VPN (skip if Tailscale covers your needs)
# cask "visual-studio-code"          # you mostly use Cursor now

